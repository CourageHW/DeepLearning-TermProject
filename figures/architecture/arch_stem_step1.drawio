        </mxCell>
        <mxCell id="subt" value="larger spatial map entering layer1  ⇒  more usable features for 32×32 inputs.   FP32 conv1 throughout (no binarization yet — teacher phase)." style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="200" y="55" width="1300" height="22" as="geometry" />
