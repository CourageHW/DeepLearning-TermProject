        <mxCell id="sk1" style="endArrow=classic;html=1;dashed=1;strokeColor=#666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="x" target="sd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sk2" style="endArrow=classic;html=1;dashed=1;strokeColor=#666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="sd" target="add1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="605" /></Array></mxGeometry></mxCell>

        <mxCell id="sk3" style="endArrow=classic;html=1;dashed=1;strokeColor=#666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="add1" target="add2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="605" /><mxPoint x="350" y="1070" /></Array></mxGeometry></mxCell>

        <mxCell id="formula" value="&lt;b&gt;Binary primitives&lt;/b&gt;&#10;&#10;&lt;b&gt;RSign(x)&lt;/b&gt;&#10;  = sign(x − θ_c)&#10;  per-channel learnable θ_c&#10;  STE: ∂ ≈ 1[|x| ≤ 1]&#10;&#10;&lt;b&gt;RPReLU(x)&lt;/b&gt;&#10;  = PReLU(x − γ_c) + β_c&#10;  per-channel γ, β, slope&#10;&#10;&lt;b&gt;A1W1BinaryConv2d&lt;/b&gt;&#10;  w_b = sign(W)   (STE, identity)&#10;  α_c = mean(|W|, dims=1,2,3)&#10;        detached (no grad)&#10;  out = conv(x, w_b) · α_c&#10;  weight clamp |W| ≤ 1 each step&#10;&#10;&lt;b&gt;ShortcutDownsample&lt;/b&gt;&#10;  AvgPool(stride) + 0-pad ch&#10;  parameter-free, BNN-friendly&#10;&#10;&lt;b&gt;Training notes&lt;/b&gt;&#10;  fp16 autocast on the spine&#10;  no EMA on student (sign collapse)&#10;  AT feature-KD on layer4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="1100" y="300" width="280" height="700" as="geometry" />
        </mxCell>
